<fensu-theme-toggle>
	<button class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
		<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
		<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
	</button>
</fensu-theme-toggle>

<script>
	class FensuThemeToggle extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector('button');
			const update = () => {
				const dark = document.documentElement.dataset.theme === 'dark';
				for (const toggle of document.querySelectorAll('fensu-theme-toggle button')) {
					toggle.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
					toggle.setAttribute('aria-pressed', String(dark));
				}
			};
			update();
			button?.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				try { localStorage.setItem('starlight-theme', next); } catch {}
				update();
			});
		}
	}
	customElements.define('fensu-theme-toggle', FensuThemeToggle);
</script>

<style>
	.theme-toggle {
		display: inline-grid;
		place-items: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 1px solid var(--sqb-line-strong);
		border-radius: 2px;
		background: transparent;
		color: var(--sqb-muted);
		cursor: pointer;
	}

	.theme-toggle:hover {
		color: var(--sqb-fg);
	}

	svg {
		width: 16px;
		height: 16px;
	}

	.icon-sun,
	:global(:root[data-theme='dark']) .icon-moon {
		display: none;
	}

	:global(:root[data-theme='dark']) .icon-sun {
		display: block;
	}
</style>
